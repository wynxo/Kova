#!/usr/bin/env bash
# Open Kova's desktop client from this checkout: ./desktop-app [--browser]
set -euo pipefail

here="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
cd -- "$here"

export PATH="$HOME/.openclaw/tools/node/bin:$HOME/.local/bin:$PATH"
if [ "${1-}" != "--browser" ] && command -v npm >/dev/null 2>&1 && [ -f desktop/package.json ]; then
    if [ -x desktop/node_modules/.bin/electron ] || (cd desktop && npm ci); then
        cd desktop
        unset ELECTRON_RUN_AS_NODE
        exec npm start -- "$@"
    fi
    printf '%s\n' 'Electron dependencies unavailable; using the Python launcher.' >&2
fi

find_uv() {
    if command -v uv >/dev/null 2>&1; then
        command -v uv
        return 0
    fi
    for candidate in "$HOME/.local/bin/uv" "$HOME/.cargo/bin/uv"; do
        if [ -x "$candidate" ]; then
            printf '%s\n' "$candidate"
            return 0
        fi
    done
    return 1
}

if ! UV="$(find_uv)"; then
    cat >&2 <<'EOF'
Kova needs uv, and uv is not installed.

Install it with:
    curl -LsSf https://astral.sh/uv/install.sh | sh

Then run ./desktop-app again. (./install.sh does all of this for you.)
EOF
    exit 1
fi

exec "$UV" run kova-app "$@"
