#!/usr/bin/env bash
# Open Kova's desktop client from this checkout: ./desktop-app [--browser]
set -euo pipefail

here="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
cd -- "$here"

find_uv() {
    if command -v uv >/dev/null 2>&1; then
        command -v uv
        return 0
    fi
    for candidate in "$HOME/.local/bin/uv" "$HOME/.cargo/bin/uv"; do
        if [ -x "$candidate" ]; then
            printf '%s\n' "$candidate"
            return 0
        fi
    done
    return 1
}

if ! UV="$(find_uv)"; then
    cat >&2 <<'EOF'
Kova needs uv, and uv is not installed.

Install it with:
    curl -LsSf https://astral.sh/uv/install.sh | sh

Then run ./desktop-app again. (./install.sh does all of this for you.)
EOF
    exit 1
fi

exec "$UV" run kova-app "$@"
