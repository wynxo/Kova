{
  "$schema": "../../design/theme.schema.json",
  "id": "high-contrast-light",
  "name": "High Contrast Light",
  "version": "1.0.0",
  "description": "Pure-white, black-text high-contrast light theme for low-vision and bright-room use. An untinted white background, black text, dark borders and a black accent chip.",
  "appearance": "light",
  "extends": "kova-light",
  "tokens": {
    "bg": {
      "base": "#ffffff",
      "surface": "#f5f5f5",
      "raised": "#e6e6e6"
    },
    "fg": {
      "default": "#000000",
      "muted": "#2e2e2e",
      "faint": "#454545"
    },
    "border": {
      "subtle": "#9a9a9a",
      "strong": "#4a4a4a"
    },
    "accent": {
      "default": "#000000",
      "hover": "#262626",
      "pressed": "#404040",
      "on": "#ffffff",
      "soft": "rgba(0, 0, 0, 0.12)"
    },
    "status": {
      "success": "#176b39"
    }
  }
}
