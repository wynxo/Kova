{
  "$schema": "https://design-tokens.org/schema/2025.10",
  "$description": "Kova design tokens. Primitive ramps are never referenced by components; only the semantic layer is. See docs/DESIGN.md and docs/research/design-ui-1-tokens-and-themes.md.",
  "primitive": {
    "orange": {
      "300": { "$type": "color", "$value": "#ffb479" },
      "400": { "$type": "color", "$value": "#ff9a52" },
      "500": { "$type": "color", "$value": "#ff7a1a" },
      "600": { "$type": "color", "$value": "#e8630a" },
      "700": { "$type": "color", "$value": "#c24f05" }
    },
    "grey": {
      "0": { "$type": "color", "$value": "#ffffff" },
      "50": { "$type": "color", "$value": "#f6f6f8" },
      "100": { "$type": "color", "$value": "#ececf1" },
      "200": { "$type": "color", "$value": "#d8d8e0" },
      "300": { "$type": "color", "$value": "#b4b4c0" },
      "400": { "$type": "color", "$value": "#8a8f98" },
      "500": { "$type": "color", "$value": "#6b7079" },
      "600": { "$type": "color", "$value": "#4a4d56" },
      "700": { "$type": "color", "$value": "#3a3d45" },
      "800": { "$type": "color", "$value": "#26262e" },
      "850": { "$type": "color", "$value": "#1c1b24" },
      "900": { "$type": "color", "$value": "#14121c" },
      "950": { "$type": "color", "$value": "#0d0c13" }
    },
    "green": { "500": { "$type": "color", "$value": "#5fd787" } },
    "amber": { "500": { "$type": "color", "$value": "#ffaf5f" } },
    "red": { "500": { "$type": "color", "$value": "#ff5f6d" } },
    "blue": { "500": { "$type": "color", "$value": "#7aa2ff" } }
  },
  "semantic": {
    "kova-dark": {
      "$description": "Default dark theme. Monochrome surfaces; orange is the only accent and means activity (#214).",
      "bg": {
        "base": { "$type": "color", "$value": "{primitive.grey.900}" },
        "surface": { "$type": "color", "$value": "{primitive.grey.850}" },
        "raised": { "$type": "color", "$value": "{primitive.grey.800}" },
        "overlay": { "$type": "color", "$value": "rgba(13, 12, 19, 0.72)" }
      },
      "fg": {
        "default": { "$type": "color", "$value": "#e8e6f0" },
        "muted": { "$type": "color", "$value": "{primitive.grey.400}" },
        "faint": { "$type": "color", "$value": "{primitive.grey.500}" },
        "inverse": { "$type": "color", "$value": "{primitive.grey.950}" }
      },
      "border": {
        "subtle": { "$type": "color", "$value": "{primitive.grey.700}" },
        "strong": { "$type": "color", "$value": "{primitive.grey.500}" }
      },
      "accent": {
        "default": { "$type": "color", "$value": "{primitive.orange.500}" },
        "hover": { "$type": "color", "$value": "{primitive.orange.400}" },
        "pressed": { "$type": "color", "$value": "{primitive.orange.600}" },
        "on": { "$type": "color", "$value": "{primitive.grey.950}" },
        "soft": { "$type": "color", "$value": "rgba(255, 122, 26, 0.14)" }
      },
      "status": {
        "success": { "$type": "color", "$value": "{primitive.green.500}" },
        "warning": { "$type": "color", "$value": "{primitive.amber.500}" },
        "danger": { "$type": "color", "$value": "{primitive.red.500}" },
        "info": { "$type": "color", "$value": "{primitive.blue.500}" }
      },
      "syntax": {
        "keyword": { "$type": "color", "$value": "#ff9a52" },
        "string": { "$type": "color", "$value": "#a8d08d" },
        "number": { "$type": "color", "$value": "#e0af68" },
        "comment": { "$type": "color", "$value": "{primitive.grey.500}" },
        "function": { "$type": "color", "$value": "#9cc4ff" },
        "type": { "$type": "color", "$value": "#8fd3c7" },
        "invalid": { "$type": "color", "$value": "{primitive.red.500}" }
      },
      "terminal": {
        "$type": "other",
        "$description": "16 ANSI roles, in order 0-15. Used by the TUI (#211) and theme export.",
        "$value": [
          "#14121c", "#ff5f6d", "#5fd787", "#ffaf5f",
          "#7aa2ff", "#c77dff", "#8fd3c7", "#d8d8e0",
          "#3a3d45", "#ff7b86", "#79e39c", "#ffc47f",
          "#96b4ff", "#d79bff", "#a9e5dc", "#f6f6f8"
        ]
      }
    },
    "kova-light": {
      "$description": "Default light theme. Same semantic names, different values.",
      "bg": {
        "base": { "$type": "color", "$value": "{primitive.grey.0}" },
        "surface": { "$type": "color", "$value": "{primitive.grey.50}" },
        "raised": { "$type": "color", "$value": "{primitive.grey.100}" },
        "overlay": { "$type": "color", "$value": "rgba(20, 18, 28, 0.55)" }
      },
      "fg": {
        "default": { "$type": "color", "$value": "{primitive.grey.900}" },
        "muted": { "$type": "color", "$value": "{primitive.grey.600}" },
        "faint": { "$type": "color", "$value": "{primitive.grey.500}" },
        "inverse": { "$type": "color", "$value": "{primitive.grey.0}" }
      },
      "border": {
        "subtle": { "$type": "color", "$value": "{primitive.grey.200}" },
        "strong": { "$type": "color", "$value": "{primitive.grey.500}" }
      },
      "accent": {
        "default": { "$type": "color", "$value": "{primitive.orange.700}" },
        "hover": { "$type": "color", "$value": "{primitive.orange.600}" },
        "pressed": { "$type": "color", "$value": "#a64203" },
        "on": { "$type": "color", "$value": "{primitive.grey.0}" },
        "soft": { "$type": "color", "$value": "rgba(194, 79, 5, 0.10)" }
      },
      "status": {
        "success": { "$type": "color", "$value": "#1f7a44" },
        "warning": { "$type": "color", "$value": "#8a5a00" },
        "danger": { "$type": "color", "$value": "#b3262f" },
        "info": { "$type": "color", "$value": "#2454a6" }
      },
      "syntax": {
        "keyword": { "$type": "color", "$value": "#a64203" },
        "string": { "$type": "color", "$value": "#2f6b3a" },
        "number": { "$type": "color", "$value": "#7a5200" },
        "comment": { "$type": "color", "$value": "{primitive.grey.500}" },
        "function": { "$type": "color", "$value": "#1f4e8c" },
        "type": { "$type": "color", "$value": "#1d6b62" },
        "invalid": { "$type": "color", "$value": "#b3262f" }
      },
      "terminal": {
        "$type": "other",
        "$description": "16 ANSI roles, in order 0-15.",
        "$value": [
          "#14121c", "#b3262f", "#1f7a44", "#8a5a00",
          "#2454a6", "#6b2fa0", "#1d6b62", "#b4b4c0",
          "#6b7079", "#d13c46", "#2a9a58", "#a87a00",
          "#3a6fc4", "#8a4bbd", "#2a8a7e", "#f6f6f8"
        ]
      }
    }
  },
  "space": {
    "0": { "$type": "dimension", "$value": "0px" },
    "0_5": { "$type": "dimension", "$value": "2px" },
    "1": { "$type": "dimension", "$value": "4px" },
    "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "12px" },
    "4": { "$type": "dimension", "$value": "16px" },
    "5": { "$type": "dimension", "$value": "20px" },
    "6": { "$type": "dimension", "$value": "24px" },
    "8": { "$type": "dimension", "$value": "32px" },
    "10": { "$type": "dimension", "$value": "40px" },
    "12": { "$type": "dimension", "$value": "48px" }
  },
  "radius": {
    "sm": { "$type": "dimension", "$value": "4px" },
    "md": { "$type": "dimension", "$value": "8px" },
    "lg": { "$type": "dimension", "$value": "12px" },
    "pill": { "$type": "dimension", "$value": "999px" }
  },
  "motion": {
    "instant": { "$type": "duration", "$value": "0ms" },
    "fast": { "$type": "duration", "$value": "120ms" },
    "base": { "$type": "duration", "$value": "180ms" },
    "slow": { "$type": "duration", "$value": "280ms" },
    "ease-standard": { "$type": "cubicBezier", "$value": [0.2, 0, 0, 1] },
    "ease-exit": { "$type": "cubicBezier", "$value": [0.4, 0, 1, 1] }
  },
  "type": {
    "size-body": { "$type": "dimension", "$value": "14px" },
    "size-body-comfortable": { "$type": "dimension", "$value": "16px" },
    "size-label": { "$type": "dimension", "$value": "12px" },
    "size-title": { "$type": "dimension", "$value": "18px" },
    "size-heading": { "$type": "dimension", "$value": "24px" },
    "leading-body": { "$type": "number", "$value": 1.55 },
    "leading-tight": { "$type": "number", "$value": 1.3 },
    "measure-prose": { "$type": "dimension", "$value": "66ch" },
    "measure-chat": { "$type": "dimension", "$value": "80ch" }
  }
}
